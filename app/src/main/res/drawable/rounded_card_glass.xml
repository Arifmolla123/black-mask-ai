<?xml version="1.0" encoding="utf-8"?>
<!-- Home cards: same shape as rounded_card, but semi-transparent so the
     animated home background glows through faintly (v4.9.11). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#C0121A2E" />
    <stroke
        android:width="1dp"
        android:color="#2A3F5F" />
    <corners android:radius="16dp" />
</shape>
