<?xml version="1.0" encoding="utf-8"?>
<!-- Floating mic bubble menu: black card, red title, essential shortcuts only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_card"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bubble_title"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FF2A3C"
        android:gravity="center"
        android:paddingBottom="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A3F5F" />

    <LinearLayout
        android:id="@+id/menuListen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="🎤"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bubble_listen"
            android:textSize="16sp"
            android:textColor="#E8ECF1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuYoutube"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="▶️"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bubble_youtube"
            android:textSize="16sp"
            android:textColor="#E8ECF1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuWhatsapp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="💬"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bubble_whatsapp"
            android:textSize="16sp"
            android:textColor="#E8ECF1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuFlashlight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="🔦"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bubble_flashlight"
            android:textSize="16sp"
            android:textColor="#E8ECF1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuSos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="🆘"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bubble_sos"
            android:textSize="16sp"
            android:textColor="#FF2A3C"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuLock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bubble_lock"
            android:textSize="16sp"
            android:textColor="#E8ECF1" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A3F5F" />

    <LinearLayout
        android:id="@+id/menuRemove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="❌"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bubble_remove"
            android:textSize="16sp"
            android:textColor="#FF2A3C" />
    </LinearLayout>

</LinearLayout>
