<!-- One question-answer pair inside the Question & answers dialog (v4.9.22). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/autoreply_qa_question"
        android:textSize="13sp"
        android:textColor="#FF777777" />

    <EditText
        android:id="@+id/qaQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/autoreply_qa_hint_q"
        android:singleLine="true"
        android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/autoreply_qa_answer"
        android:textSize="13sp"
        android:textColor="#FF777777" />

    <EditText
        android:id="@+id/qaAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/autoreply_qa_hint_a"
        android:minLines="2"
        android:inputType="textMultiLine" />

    <Button
        android:id="@+id/qaRemove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:background="@drawable/btn_dark"
        android:text="@string/autoreply_qa_remove"
        android:textColor="#FFFF4444"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#FFDDDDDD" />

</LinearLayout>
