<?xml version="1.0" encoding="utf-8"?>
<!-- Tools page -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tools_quick"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#7A8699"
            android:letterSpacing="0.15"
            android:paddingBottom="6dp" />

        <HorizontalScrollView
            android:id="@+id/chipScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chip1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#E8ECF1"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/chip2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#E8ECF1"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/chip3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/chip_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#E8ECF1"
                    android:textSize="12sp" />

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tools_try"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#7A8699"
            android:letterSpacing="0.15"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_01"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_02"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_03"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_04"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_05"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_06"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_07"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_08"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_09"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_10"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_11"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_12"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_13"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_14"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_15"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_16"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_17"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_18"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_19"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_sos"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_ex_21"
                android:textColor="#E8ECF1"
                android:textSize="14sp"
                android:padding="4dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scheduled_sms_title"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#7A8699"
            android:letterSpacing="0.15"
            android:paddingTop="16dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scheduled_sms_desc"
                android:textSize="11sp"
                android:textColor="#9AA5B1"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/smsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sms_not_set"
                    android:textSize="12sp"
                    android:textColor="#9AA5B1" />

                <Button
                    android:id="@+id/smsPickBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_dark"
                    android:text="@string/sms_select"
                    android:textColor="#FF2A3C"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/smsMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_input"
                android:hint="@string/sms_message_hint"
                android:textColor="#E8ECF1"
                android:textColorHint="#7A8699"
                android:padding="10dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/smsTimeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sms_no_time"
                    android:textSize="12sp"
                    android:textColor="#9AA5B1" />

                <Button
                    android:id="@+id/smsTimeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_dark"
                    android:text="@string/sms_pick_time"
                    android:textColor="#FF2A3C"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/smsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#FF2A3C"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/smsScheduleBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:text="@string/sms_schedule"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/smsCancelBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_dark"
                    android:text="@string/sms_cancel"
                    android:textColor="#FF2A3C"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
